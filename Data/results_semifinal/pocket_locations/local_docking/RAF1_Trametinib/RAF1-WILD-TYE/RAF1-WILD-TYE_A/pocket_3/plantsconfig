
# scoring function and search settings
scoring_function chemplp
search_speed speed1

# input
protein_file RAF1-WILD-TYE_A_prepared_protonated_7.4_PLANTS.mol2
ligand_file RAF1_Trametinib_PLANTS_SPORES.mol2

# output
output_dir plants_output

# write single mol2 files (e.g. for RMSD calculation)
write_multi_mol2 0

# binding site definition
bindingsite_center 8.591 4.423 -16.306
bindingsite_radius 26.0

# cluster algorithm
cluster_structures 10
cluster_rmsd 2.0
