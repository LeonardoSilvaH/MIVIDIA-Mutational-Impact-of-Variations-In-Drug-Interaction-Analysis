
# scoring function and search settings
scoring_function chemplp
search_speed speed1

# input
protein_file KRAS-G13R_A_prepared_protonated_7.4_PLANTS.mol2
ligand_file KRAS_Sorafenib_PLANTS_SPORES.mol2

# output
output_dir plants_output

# write single mol2 files (e.g. for RMSD calculation)
write_multi_mol2 0

# binding site definition
bindingsite_center 5.621 9.585 -6.191
bindingsite_radius 26.0

# cluster algorithm
cluster_structures 10
cluster_rmsd 2.0
