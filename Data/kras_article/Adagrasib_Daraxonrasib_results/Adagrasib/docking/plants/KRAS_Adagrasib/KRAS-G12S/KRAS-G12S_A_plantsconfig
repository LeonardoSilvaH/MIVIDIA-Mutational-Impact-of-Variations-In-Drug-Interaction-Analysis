
# scoring function and search settings
scoring_function chemplp
search_speed speed1

# input
protein_file KRAS-G12S_A_SPORES.mol2
ligand_file KRAS_Adagrasib_SPORES.mol2

# output
output_dir KRAS-G12S_A

# write single mol2 files (e.g. for RMSD calculation)
write_multi_mol2 0

# binding site definition
bindingsite_center -7.0320000648498535 1.1790000200271606 1.6629999876022339
bindingsite_radius 81.0

# cluster algorithm
cluster_structures 100
cluster_rmsd 2.0
