
# scoring function and search settings
scoring_function chemplp
search_speed speed1

# input
protein_file KRAS-G13R_A_SPORES.mol2
ligand_file KRAS_Adagrasib_SPORES.mol2

# output
output_dir KRAS-G13R_A

# write single mol2 files (e.g. for RMSD calculation)
write_multi_mol2 0

# binding site definition
bindingsite_center -7.048999786376953 1.1710000038146973 1.4839999675750732
bindingsite_radius 82.0

# cluster algorithm
cluster_structures 100
cluster_rmsd 2.0
