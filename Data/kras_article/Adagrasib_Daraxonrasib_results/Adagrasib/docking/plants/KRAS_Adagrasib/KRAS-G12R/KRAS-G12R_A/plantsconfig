
# scoring function and search settings
scoring_function chemplp
search_speed speed1

# input
protein_file KRAS-G12R_A_SPORES.mol2
ligand_file KRAS_Adagrasib_SPORES.mol2

# output
output_dir KRAS-G12R_A

# write single mol2 files (e.g. for RMSD calculation)
write_multi_mol2 0

# binding site definition
bindingsite_center -2.328000068664551 -2.2730000019073486 2.438999891281128
bindingsite_radius 89.0

# cluster algorithm
cluster_structures 100
cluster_rmsd 2.0
