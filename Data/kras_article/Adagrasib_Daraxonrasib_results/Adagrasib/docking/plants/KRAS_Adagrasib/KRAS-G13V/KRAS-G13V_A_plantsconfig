
# scoring function and search settings
scoring_function chemplp
search_speed speed1

# input
protein_file KRAS-G13V_A_SPORES.mol2
ligand_file KRAS_Adagrasib_SPORES.mol2

# output
output_dir KRAS-G13V_A

# write single mol2 files (e.g. for RMSD calculation)
write_multi_mol2 0

# binding site definition
bindingsite_center -6.783999919891357 2.2300000190734863 2.0980000495910645
bindingsite_radius 85.0

# cluster algorithm
cluster_structures 100
cluster_rmsd 2.0
