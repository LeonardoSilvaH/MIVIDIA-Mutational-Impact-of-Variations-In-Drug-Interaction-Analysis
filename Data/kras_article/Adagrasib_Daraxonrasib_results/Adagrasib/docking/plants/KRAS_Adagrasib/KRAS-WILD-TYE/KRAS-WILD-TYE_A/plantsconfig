
# scoring function and search settings
scoring_function chemplp
search_speed speed1

# input
protein_file KRAS-WILD-TYE_A_SPORES.mol2
ligand_file KRAS_Adagrasib_SPORES.mol2

# output
output_dir KRAS-WILD-TYE_A

# write single mol2 files (e.g. for RMSD calculation)
write_multi_mol2 0

# binding site definition
bindingsite_center -6.915999889373779 0.925000011920929 1.5369999408721924
bindingsite_radius 78.0

# cluster algorithm
cluster_structures 100
cluster_rmsd 2.0
