
# scoring function and search settings
scoring_function chemplp
search_speed speed1

# input
protein_file KRAS-G13C_A_SPORES.mol2
ligand_file KRAS_Adagrasib_SPORES.mol2

# output
output_dir KRAS-G13C_A

# write single mol2 files (e.g. for RMSD calculation)
write_multi_mol2 0

# binding site definition
bindingsite_center -6.8520002365112305 0.8429999947547913 1.6200000047683716
bindingsite_radius 75.0

# cluster algorithm
cluster_structures 100
cluster_rmsd 2.0
